{% layout none %}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>WavesRx x Costo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/x-icon" href="https://cdn.shopify.com/s/files/1/0269/9198/4729/files/PNG.png?v=1750414896">
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@500;700;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
          font-family: 'Red Hat Display', sans-serif;
          background: #fff;
          color: #111;
        }
        h1 {
          font-size: 5rem;
        }
        h2 {
          font-size: 2.9rem;
        }
        a {
          text-decoration: none;
        }
        h1, h2 {
          font-weight: 900;
        }
        h1, h2, h3, h4, h5, p, span, a {
          color: #000;
        }
        p {
          font-size: 21px;
        }
        .section, section {
          padding-top: 60px;
        }
        h3 {
          text-transform: uppercase;
          margin-bottom: 2.3rem;
          color: #000;
          font-weight: 700;
        }
        .product-card h2 {
          margin-top: 20px;
          text-align: center;
          text-transform: capitalize !important;
        }
        .product-card h2 {
          font-size: 31px;
          font-weight: 900;
        }
        .product-card {
          background-color: #fff;
          border-style: solid;
          border-width: 1px;
          border-color: #e6e6e6;
          box-shadow: 0 4px 12px #b4b4b440;
          padding: 60px 35px;
          border-radius: 10px;
        }
        .product-card p {
          color: #000;
          font-weight: 700;
          font-size: 18px;
        }
        .btn-primary {
          background-color: #2b4d8c;
          color: #fff;
          font-weight: 600;
          border-radius: 50px;
          padding: 10px 24px;
          font-size: 1rem;
          text-align: center;
          display: inline-block;
          transition: background-color 0.3s ease;
          text-decoration: none;
          border: 0px;
          margin: 2px 0;
        }
        .btn-primary:hover {
          background-color: #000;
          color: #fff;
        }
        .hero-section {
          background: url(https://cdn.shopify.com/s/files/1/0726/1221/7115/files/ecom-no-replace-8bZgg7wp8ybg-vac-hero.png?v=1713844982) no-repeat scroll center center/cover #fff;
          background-size: cover;
          padding: 80px 20px;
        }
        h1 {
          font-family: 'Red Hat Display', sans-serif;
          font-size: 100px;
          font-weight: 900;
          margin-bottom: 20px;
          color: #000;
        }
        .hero-text {
          font-size: 1.2rem;
          line-height: 1.6;
          color: #000;
        }
    </style>
</head>

<body>
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                    <h1 class="hero-title">WavesRx x Costo</h1>
            </div>
        </div>
    </section>
</body>

</html>